import javax.microedition.midlet.*;
import javax.microedition.lcdui.*;
import javax.microedition.io.*;
import javax.microedition.rms.*;
import java.io.*;
import java.util.*;

public class Browser extends MIDlet implements CommandListener {
    static final String DEFAULT_SERVER = "http://192.168.1.5:8080";

    Display display;
    PageCanvas canvas;
    Form urlForm, setForm;
    TextField tfUrl, tfServer;

    Command cOpen = new Command("Go to", Command.SCREEN, 1);
    Command cBack = new Command("Back", Command.SCREEN, 2);
    Command cPrev = new Command("Prev page", Command.SCREEN, 3);
    Command cNext = new Command("Next page", Command.SCREEN, 4);
    Command cSet = new Command("Server", Command.SCREEN, 5);
    Command cExit = new Command("Exit", Command.EXIT, 1);
    Command cOk = new Command("OK", Command.OK, 1);
    Command cCancel = new Command("Cancel", Command.BACK, 1);

    String server = DEFAULT_SERVER;
    Vector history = new Vector();
    String curUrl = null;
    int curPage = 0, totalPages = 1;

    public void startApp() {
        if (canvas != null) return;
        display = Display.getDisplay(this);
        loadSettings();
        canvas = new PageCanvas(this);
        canvas.addCommand(cOpen);
        canvas.addCommand(cBack);
        canvas.addCommand(cPrev);
        canvas.addCommand(cNext);
        canvas.addCommand(cSet);
        canvas.addCommand(cExit);
        canvas.setCommandListener(this);
        canvas.setMessage("Menu > Go to: type address or search words");
        display.setCurrent(canvas);
    }

    public void pauseApp() {}

    public void destroyApp(boolean u) {}

    public void commandAction(Command c, Displayable d) {
        if (c == cExit) {
            notifyDestroyed();
        } else if (c == cOpen) {
            urlForm = new Form("Go to");
            tfUrl = new TextField("Address / search", curUrl == null ? "" : curUrl, 300, TextField.ANY);
            urlForm.append(tfUrl);
            urlForm.addCommand(cOk);
            urlForm.addCommand(cCancel);
            urlForm.setCommandListener(this);
            display.setCurrent(urlForm);
        } else if (c == cSet) {
            setForm = new Form("Server");
            tfServer = new TextField("Proxy URL", server, 100, TextField.URL);
            setForm.append(tfServer);
            setForm.addCommand(cOk);
            setForm.addCommand(cCancel);
            setForm.setCommandListener(this);
            display.setCurrent(setForm);
        } else if (c == cOk) {
            if (d == urlForm) {
                display.setCurrent(canvas);
                openLink(tfUrl.getString());
            } else if (d == setForm) {
                server = tfServer.getString().trim();
                if (server.endsWith("/")) server = server.substring(0, server.length() - 1);
                saveSettings();
                display.setCurrent(canvas);
            }
        } else if (c == cCancel) {
            display.setCurrent(canvas);
        } else if (c == cBack) {
            goBack();
        } else if (c == cPrev) {
            prevPage();
        } else if (c == cNext) {
            nextPage();
        }
    }

    void openLink(String url) {
        if (curUrl != null) history.addElement(new String[] { curUrl, "" + curPage });
        load(url, 0);
    }

    void goBack() {
        if (history.size() == 0) return;
        String[] h = (String[]) history.elementAt(history.size() - 1);
        history.removeElementAt(history.size() - 1);
        load(h[0], Integer.parseInt(h[1]));
    }

    void nextPage() {
        if (curUrl != null && curPage + 1 < totalPages) load(curUrl, curPage + 1);
    }

    void prevPage() {
        if (curUrl != null && curPage > 0) load(curUrl, curPage - 1);
    }

    void load(final String url, final int page) {
        canvas.setStatus("Loading...");
        new Thread() {
            public void run() {
                try {
                    String full = server + "/m?u=" + enc(url) + "&p=" + page;
                    byte[] data = fetch(full);
                    parse(new String(data, "UTF-8"));
                } catch (Throwable e) {
                    canvas.setStatus("Error: " + e);
                }
            }
        }.start();
    }

    void parse(String s) {
        Vector items = new Vector();
        int pos = 0;
        boolean first = true;
        while (pos < s.length()) {
            int nl = s.indexOf('\n', pos);
            if (nl < 0) nl = s.length();
            String line = s.substring(pos, nl);
            pos = nl + 1;
            if (line.length() == 0) continue;
            Vector f = split(line);
            String type = (String) f.elementAt(0);
            if (first && type.equals("P")) {
                curPage = Integer.parseInt((String) f.elementAt(1));
                totalPages = Integer.parseInt((String) f.elementAt(2));
                curUrl = (String) f.elementAt(3);
                first = false;
            } else if (type.equals("T") && f.size() >= 2) {
                items.addElement(new String[] { "T", (String) f.elementAt(1), null });
            } else if (type.equals("L") && f.size() >= 3) {
                items.addElement(new String[] { "L", (String) f.elementAt(2), (String) f.elementAt(1) });
            }
        }
        canvas.setItems(items, (curPage + 1) + "/" + totalPages);
    }

    static Vector split(String line) {
        Vector v = new Vector();
        int pos = 0;
        while (true) {
            int t = line.indexOf('\t', pos);
            if (t < 0) {
                v.addElement(line.substring(pos));
                break;
            }
            v.addElement(line.substring(pos, t));
            pos = t + 1;
        }
        return v;
    }

    static byte[] fetch(String url) throws IOException {
        HttpConnection c = null;
        InputStream is = null;
        try {
            c = (HttpConnection) Connector.open(url);
            c.setRequestMethod(HttpConnection.GET);
            c.setRequestProperty("User-Agent", "NokiaBrowser/1.0");
            is = c.openInputStream();
            ByteArrayOutputStream bo = new ByteArrayOutputStream();
            byte[] buf = new byte[1024];
            int n;
            while ((n = is.read(buf)) != -1) bo.write(buf, 0, n);
            return bo.toByteArray();
        } finally {
            try { if (is != null) is.close(); } catch (Exception e) {}
            try { if (c != null) c.close(); } catch (Exception e) {}
        }
    }

    static String enc(String s) {
        byte[] b;
        try {
            b = s.getBytes("UTF-8");
        } catch (Exception e) {
            b = s.getBytes();
        }
        StringBuffer sb = new StringBuffer();
        String hex = "0123456789ABCDEF";
        for (int i = 0; i < b.length; i++) {
            int c = b[i] & 0xff;
            if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')
                    || c == '-' || c == '_' || c == '.') {
                sb.append((char) c);
            } else {
                sb.append('%').append(hex.charAt(c >> 4)).append(hex.charAt(c & 15));
            }
        }
        return sb.toString();
    }

    void loadSettings() {
        try {
            RecordStore rs = RecordStore.openRecordStore("cfg", true);
            if (rs.getNumRecords() > 0) server = new String(rs.getRecord(1), "UTF-8");
            rs.closeRecordStore();
        } catch (Exception e) {}
    }

    void saveSettings() {
        try {
            byte[] b = server.getBytes("UTF-8");
            RecordStore rs = RecordStore.openRecordStore("cfg", true);
            if (rs.getNumRecords() == 0) rs.addRecord(b, 0, b.length);
            else rs.setRecord(1, b, 0, b.length);
            rs.closeRecordStore();
        } catch (Exception e) {}
    }
}
